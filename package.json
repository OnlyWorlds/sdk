{
  "name": "@onlyworlds/sdk",
  "version": "4.123.2",
  "description": "TypeScript SDK for the OnlyWorlds API - build world-building applications with type safety",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./waymark": {
      "types": "./dist/waymark.d.ts",
      "import": "./dist/waymark.js"
    },
    "./waymark.css": "./dist/waymark.css",
    "./package.json": "./package.json"
  },
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "SCHEMA.md"
  ],
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.waymark src/waymark/index.ts --format esm --clean && tsup --entry.index src/index.ts --format esm --dts-only && tsup --entry.waymark src/waymark/index.ts --format esm --dts-only && node -e \"require('fs').copyFileSync('src/waymark/waymark.css', 'dist/waymark.css')\"",
    "dev": "tsup --entry.index src/index.ts --entry.waymark src/waymark/index.ts --format esm --dts --watch",
    "pretest": "npm run build",
    "test": "node --test",
    "codegen": "python codegen/generate_types.py && node codegen/tools.mjs",
    "codegen:check": "python codegen/generate_types.py --check && node codegen/tools.mjs --check",
    "schema:verify": "python codegen/verify_dist.py",
    "schema:check": "npm run schema:verify && npm run codegen:check",
    "prepublishOnly": "npm run build",
    "release:verify": "node codegen/verify_release.mjs",
    "demo": "npm run build && node scripts/serve-demo.mjs"
  },
  "keywords": [
    "onlyworlds",
    "worldbuilding",
    "api",
    "sdk",
    "typescript",
    "rpg",
    "ttrpg",
    "game-development"
  ],
  "author": "OnlyWorlds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OnlyWorlds/sdk.git"
  },
  "homepage": "https://onlyworlds.github.io/",
  "bugs": {
    "url": "https://github.com/OnlyWorlds/sdk/issues"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
